{
  "datasets": [
    {
      "name": "a48eed5e",
      "displayName": "violations",
      "queryLines": [
        "SELECT\n",
        "  *,\n",
        "  CAST(violation_year AS STRING) AS year_label,\n",
        "  CASE WHEN is_health_based THEN 'Health-based' ELSE 'Other' END AS violation_type,\n",
        "  CASE WHEN is_health_based THEN 1 ELSE 0 END AS health_based_flag,\n",
        "  CASE WHEN is_health_based THEN pwsid END AS health_based_pwsid,\n",
        "  CASE\n",
        "    WHEN days_to_compliance IS NULL THEN '6. No return date'\n",
        "    WHEN days_to_compliance <= 30  THEN '1. Up to 30 days'\n",
        "    WHEN days_to_compliance <= 90  THEN '2. 31–90 days'\n",
        "    WHEN days_to_compliance <= 180 THEN '3. 91–180 days'\n",
        "    WHEN days_to_compliance <= 365 THEN '4. 181–365 days'\n",
        "    ELSE '5. Over 1 year'\n",
        "  END AS time_to_compliance\n",
        "FROM workspace.sdwa_gold.fact_violations"
      ]
    },
    {
      "name": "a5697dfb",
      "displayName": "counties",
      "queryLines": [
        "WITH hb_population AS (\n",
        "  SELECT county, SUM(population_served) AS population_in_systems_with_hb_violation\n",
        "  FROM (\n",
        "    SELECT DISTINCT pwsid, county, population_served\n",
        "    FROM workspace.sdwa_gold.fact_violations\n",
        "    WHERE is_health_based\n",
        "      AND system_is_active\n",
        "      AND system_type = 'Community water system'\n",
        "  )\n",
        "  GROUP BY county\n",
        ")\n",
        "SELECT\n",
        "  c.*,\n",
        "  COALESCE(h.population_in_systems_with_hb_violation, 0) AS population_in_systems_with_hb_violation\n",
        "FROM workspace.sdwa_gold.county_summary c\n",
        "LEFT JOIN hb_population h ON c.county = h.county"
      ]
    },
    {
      "name": "4855eff9",
      "displayName": "county_ranking",
      "queryLines": [
        "SELECT\n",
        "  county,\n",
        "  active_systems,\n",
        "  community_population_served,\n",
        "  violations,\n",
        "  health_based_violations,\n",
        "  systems_with_health_based_violation,\n",
        "  pct_systems_with_health_based_violation\n",
        "FROM workspace.sdwa_gold.county_summary\n",
        "WHERE active_systems >= 10\n",
        "  AND county <> 'Unknown county'"
      ]
    },
    {
      "name": "6b94e37e",
      "displayName": "county_top15",
      "queryLines": [
        "SELECT county, active_systems, pct_systems_with_health_based_violation\n",
        "FROM workspace.sdwa_gold.county_summary\n",
        "WHERE active_systems >= 10\n",
        "  AND county <> 'Unknown county'\n",
        "ORDER BY pct_systems_with_health_based_violation DESC, active_systems DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "35212544",
      "displayName": "heatmap_grid",
      "queryLines": [
        "WITH counties AS (\n",
        "  SELECT DISTINCT county FROM workspace.sdwa_gold.dim_water_system\n",
        "),\n",
        "years AS (\n",
        "  SELECT explode(sequence(2021, 2025)) AS violation_year\n",
        "),\n",
        "categories AS (\n",
        "  SELECT DISTINCT violation_category FROM workspace.sdwa_gold.fact_violations\n",
        "),\n",
        "counts AS (\n",
        "  SELECT county, violation_year, violation_category,\n",
        "         COUNT(*) AS violations\n",
        "  FROM workspace.sdwa_gold.fact_violations\n",
        "  GROUP BY ALL\n",
        ")\n",
        "SELECT\n",
        "  c.county,\n",
        "  CAST(y.violation_year AS STRING) AS year_label,\n",
        "  k.violation_category,\n",
        "  COALESCE(n.violations, 0) AS violations\n",
        "FROM counties c\n",
        "CROSS JOIN years y\n",
        "CROSS JOIN categories k\n",
        "LEFT JOIN counts n\n",
        "  ON  n.county = c.county\n",
        "  AND n.violation_year = y.violation_year\n",
        "  AND n.violation_category = k.violation_category"
      ]
    }
  ],
